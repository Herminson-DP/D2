rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Allow public read for products, categories, discounts, taxes so guest visitors can view the store
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /discounts/{discountId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /taxes/{taxId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders / Receipts
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
  }
}
